{
  "name": "braindump",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "bun server/index.ts",
    "test": "bun test",
    "test:live": "bun scripts/check-live.ts",
    "import": "bun scripts/import.ts",
    "setup": "bun scripts/setup.ts",
    "format": "prettier --write . --ignore-unknown && uv run --locked --project scraper ruff format scraper",
    "format:check": "prettier --check . --ignore-unknown && uv run --locked --project scraper ruff format --check scraper",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives src server scripts tests public vite.config.ts",
    "lint:docs": "markdownlint-cli2",
    "check:repo": "bun scripts/check-repo.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check:python": "uv run --locked --project scraper ruff check scraper",
    "check:locks": "bun install --frozen-lockfile --ignore-scripts && uv lock --project scraper --check",
    "test:python": "uv run --locked --project scraper python -m unittest discover -s scraper/tests -v",
    "verify": "bun scripts/verify.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.2.6",
    "entities": "8.1.0",
    "lucide-react": "1.43.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "github-slugger": "2.0.0",
    "happy-dom": "20.14.3",
    "markdownlint-cli2": "0.23.2",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "12.0.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  }
}
