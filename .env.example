PORT=3210
DATA_DIR=./data
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b-mlx
# One inference at a time; 16K context keeps memory use sensible on a 24 GB Mac.
OLLAMA_CONTEXT=16384
# Daily tag review and rotating automatic backups, while the app is running.
TAG_REVIEW_HOURS=24
BACKUP_HOURS=24
