{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Braindump",
  "version": "0.1.0",
  "identifier": "com.joshuawoolf.braindump",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "resources/": "./"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
